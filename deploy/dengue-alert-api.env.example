# Copiado para /etc/dengue-alert-api.env (permissão 600) pelo install.sh. Preencha antes de iniciar o serviço.
# Sem aspas; evite ';' dentro da senha.

# MySQL em Docker (docker compose up -d mysql) publicado em 127.0.0.1:3308
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3308;Database=dengue_alert;User=dengue;Password=TROQUE_A_SENHA;
Database__ServerVersion=8.4.0

# Origem do front-end autorizada no CORS
Cors__AllowedOrigins__0=https://dengue.braggo.com.br

# Chave dos endpoints /api/admin (header X-Api-Key). Gere com: openssl rand -hex 32
Admin__ApiKey=TROQUE_PELA_CHAVE

# Opcionais (valores padrão em appsettings.json)
# Sync__Enabled=true
# Sync__DayOfWeek=Monday
# Sync__TimeOfDay=03:00
# Sync__MaxNewCitiesPerHour=25   # teto de cidades novas buscadas no InfoDengue por hora (0 = sem limite)
