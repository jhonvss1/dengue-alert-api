# Copie para .env e preencha. O arquivo .env nunca deve ser versionado.
# Evite ';' e aspas nas senhas (elas entram na connection string).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=dengue_alert
MYSQL_USER=dengue
MYSQL_PASSWORD=troque-esta-senha
# Porta do MySQL publicada apenas em 127.0.0.1 (administração local)
MYSQL_HOST_PORT=3308

# A configuração da API (CORS, chave admin, connection string) não fica aqui:
#  - no servidor: /etc/dengue-alert-api.env (modelo em deploy/dengue-alert-api.env.example)
#  - no seu computador: dotnet user-secrets (veja o README)
